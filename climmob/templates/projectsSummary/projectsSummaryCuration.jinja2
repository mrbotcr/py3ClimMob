{% extends 'dashboard/dashboard.jinja2' %}

{% block title %}
    <title>{{ _("ClimMob | Projects Summary Curation") }}</title>
{% endblock title %}

{% block css %}

    {% cssresource request,'coreresources','chosen' %}
    {% cssresource request,'coreresources','jquery' %}
    {% cssresource request, 'coreresources', 'dataTable_2-0-7' %}
    {% cssresource request, 'coreresources', 'dataTables_buttons' %}
    {% cssresource request, 'coreresources', 'sweetAlert' %}
    <style>
        th {
            text-align: left;
            max-width: 400px;
            text-overflow: ellipsis;
            overflow: hidden;
            white-space: nowrap;
        }

        table.dataTable tfoot select {
            width: 100%;
            text-overflow: ellipsis;
            overflow: hidden;
            white-space: nowrap;
        }

        td {
            max-width: 400px;
            word-wrap: break-word;
        }
    </style>

{% endblock css %}

{% block topScripts %}

    {% jsresource request,'coreresources','toastr' %}
    {% jsresource request,'coreresources','datapicker' %}
    {% jsresource request,'coreresources','chosen' %}
    {% jsresource request, 'coreresources', 'dataTablesjs_2-0-7' %}
    {% jsresource request, 'coreresources', 'ButtonsDataTables_2-0-7' %}
    {% jsresource request, 'coreresources', 'ColvisDataTables_2-0-7' %}
    {% jsresource request, 'coreresources', 'bootstrapDataTables_2-0-7' %}
    {% jsresource request, 'coreresources', 'sweetAlert' %}

{% endblock topScripts %}

{% block pageheading %}
    {% set _title= _("Projects Summary Curation Table") %}
    {% include 'snippets/menuheading.jinja2' %}
{% endblock pageheading %}

{% block pagecontent %}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox">
            <div class="ibox-title">
                <h5>Data Filter</h5>
                <div class="ibox-tools">
                    <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                </div>
            </div>
            <div class="ibox-content">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="min-farm-registered">{{ _("Minimum Farmers Registered: ") }}</label>
                        <input type="text" id="min-farm-registered" name="min-farm-registered" class="form-control">
                    </div>
                    <div class="col-md-6">
                        <label for="max-farm-registered">{{ _("Maximum Farmers Registered: ") }}</label>
                        <input type="text" id="max-farm-registered" name="max-farm-registered" class="form-control">
                    </div>
                </div>
                <br>

                <div class="row mb-3">
                    <div class="col-md-6" id="custom-buttons">
                    </div>
                    <div class="col-md-6 text-end" id="custom-search">
                    </div>
                </div>
                <br>
                <div class="row mb-3">
                    <div class="btn-group col-md-6" id="custom-pagination">
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>{{ _("Curation Table") }}</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <div class="table-responsive">
                    <div id="footable-wrapper">
                        <table class="footable table table-stripped display " data-filter=#filter id="curation-table">
                            <thead>
                            <tr>
                                <th>#</th>
                                {% for col in tableStructure %}
                                    {% if col["show"] %}
                                        <th>{{ col["column_name"] }}</th>
                                    {% endif %}
                                {% endfor %}
                                <th></th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for project in listOfProjects %}
                                <tr>
                                    <td data-column="index">{{ '%04d' % loop.index }}</td>

                                    {% for col in tableStructure %}
                                        {% if col["show"] %}
                                            {% if not col['field_editable'] %}
                                                <td data-column="{{ col["key"] }}">{{ project[col["key"]] }}</td>
                                            {% else %}
                                                {% if col['type'] == "input" %}
                                                    <td contenteditable="true" data-column="{{ col["key"] }}">
                                                        <input value="{{ project[col["key"]] if project[col["key"]] }}">
                                                    </td>
                                                {% endif %}
                                                {% if col['type'] == "dropdown" %}
                                                    <td contenteditable="true" data-column="{{ col["key"] }}">
                                                        <select>
                                                            <option value="2" {% if project[col["key"]] == 2 %}
                                                                    selected="selected" {% endif %}>{{ _("Verify") }}</option>
                                                            <option value="1" {% if project[col["key"]] == 1 %}
                                                                    selected="selected" {% endif %}>{{ _("Yes") }}</option>
                                                            <option value="0" {% if project[col["key"]] == 0 %}
                                                                    selected="selected" {% endif %}>{{ _("No") }}</option>
                                                        </select>
                                                    </td>
                                                {% endif %}
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}
                                    <td class="no-filter">
                                        <button data-column="save" class="btn btn-primary pull-right" onclick="checkInputs(this)">
                                            {{ _("Save") }}
                                        </button>
                                    </td>
                                    <td class="no-filter">
                                        <button data-column="summary" class="btn btn-outline btn-info" onclick="CheckInfo(this)">
                                            {{ _("Summary") }}
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>#</th>
                                    {% for col in tableStructure %}
                                        {% if col["show"] %}
                                            <th>{{ col["column_name"] }}</th>
                                        {% endif %}
                                    {% endfor %}
                                    <th></th>
                                    <th></th>
                                </tr>

                            </tfoot>

                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>





    <script>
        const minEl = document.querySelector('#min-farm-registered');
        const maxEl = document.querySelector('#max-farm-registered');

        const table = new DataTable('#curation-table', {

            layout: {
                topStart: {
                    buttons: [
                        {
                            extend: 'colvis',
                            text: '{{ _("Show/Hide Columns") }}',
                            className: 'btn btn-primary '
                        },
                        {
                            extend: 'pageLength',
                            text: '{{ _("Rows per Page") }}',
                            className: 'btn btn-default '
                        }
                    ],
                },
                topEnd: {
                    search: {
                        return: true,
                        text: '{{ _("Search: ") }}',
                    },
                },
                bottomStart: {
                    info: {
                        return: true,
                        text: "{{ _('Showing _START_ to _END_ of _TOTAL_ entries') }}",
                    },
                },

            },

            initComplete: function () {
                const buttonsContainer = document.querySelector('#curation-table_wrapper .dt-buttons');
                document.getElementById('custom-buttons').appendChild(buttonsContainer);

                const searchInputContainer = document.querySelector('#curation-table_wrapper div.dt-search');
                if (searchInputContainer) {
                    document.getElementById('custom-search').appendChild(searchInputContainer);
                }

                const paginationContainer = document.querySelector('#curation-table_wrapper .dt-paging');
                if (paginationContainer) {
                    document.getElementById('custom-pagination').appendChild(paginationContainer);
                }

                this.api()
                    .columns()
                    .every(function (colIdx) {

                        if (colIdx === 38 || colIdx === 39 ) return;
                        const column = this;

                        const select = document.createElement('select');
                        select.add(new Option(''));
                        column.footer().replaceChildren(select);

                        const uniqueValues = new Set();

                        column.nodes().each(function (cell) {
                            let value;
                            const selectEl = cell.querySelector('select');
                            if (selectEl) {
                                value = selectEl.options[selectEl.selectedIndex].text.trim();
                            } else {
                                value = cell.textContent.trim();
                            }
                            if (value && !uniqueValues.has(value)) {
                                uniqueValues.add(value);
                                select.add(new Option(value));
                            }
                        });

                        select.addEventListener('change', function () {
                            const selectedValue = this.value;

                            column
                                .search(selectedValue ? '^' + selectedValue + '$' : '', {
                                    regex: true,
                                    caseInsensitive: true
                                })
                                .draw();
                        });
                    });
            }
        });

        table.search.fixed('range', function (searchStr, data) {
            const min1 = parseInt(minEl.value, 10);
            const max1 = parseInt(maxEl.value, 10);
            const val1 = parseFloat(data[12]) || 0;


            const pass1 =
                (isNaN(min1) && isNaN(max1)) ||
                (isNaN(min1) && val1 <= max1) ||
                (min1 <= val1 && isNaN(max1)) ||
                (min1 <= val1 && val1 <= max1);

            return pass1;
        });


        [minEl, maxEl].forEach(el => {
            el.addEventListener('input', () => table.draw());
        });

        function checkInputs(button) {
            const row = button.closest('tr');
            const project_id = row.querySelector('[data-column="project_id"]').textContent.trim();
            const rowNumber = row.querySelector('[data-column="index"]').textContent.trim();
            const fieldAffiliation = row.querySelector('[data-column="affiliation"] input');
            const fieldCrop = row.querySelector('[data-column="cropname"] input');
            const fieldAnalytics = row.querySelector('[data-column="climmob_analytics"] select');

            let error = [];
            if (!fieldAffiliation || fieldAffiliation.value.trim() === '') {
                error.push('Affiliation');
            }

            if (!fieldCrop || fieldCrop.value.trim() === '') {
                error.push('{{ _("Curated crop name") }}');
            }

            if (!fieldAnalytics || fieldAnalytics.value.trim() === '2') {
                error.push('{{ _("Dashboard") }}');
            }
            if (error.length > 0) {
                swal(
                    "{{ _('Check the row ') }}" + rowNumber,
                    "{{ _('Please, complete these empty fields: ') }}" + error.join(', ') + "{{ _(' to continue') }}",
                    "error"
                );

            } else {
                const data = {
                    project_id: project_id,
                    affiliation: fieldAffiliation.value.trim(),
                    crop: fieldCrop.value.trim(),
                    analytics: fieldAnalytics.value.trim()
                }

                fetch('/climmob3/projectsSummaryCurationUpdateRow',{
                    method:'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                })
                    .then(response => {
                        if (!response.ok) throw new Error("{{ _('Error') }}");
                        return response.json();
                    })
                    .then(data => {
                        swal("{{ _('Data Update, row ') }}" + rowNumber, data.message, "success");
                    })
                    .catch(error => {
                        swal("{{ _('Error') }}", error.message, "error");
                    });

            }
        }

        function CheckInfo(button) {
            const row = button.closest('tr');
            const cells = row.querySelectorAll('td');
            let summary = '';
            cells.forEach(cell => {
                const column = cell.getAttribute('data-column');
                const value = cell.textContent.trim();

                if (!column) return;
                summary += `${column}: ${value}\n`;

              });
            swal("",summary);
        }


    </script>

{% endblock pagecontent %}

