<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f9f9f9;
            padding: 20px;
            color: #333;
            line-height: 1.6;
            margin: 0;
            text-align: center;
        !important;
        }

        .email-container {
            background-color: #ffffff;
            border: 1px solid #ddd;
            padding: 30px;
            border-radius: 6px;
            margin: 0 auto;
            width: 600px;
            display: inline-block;
        !important;
            text-align: left;
        }
    </style>
</head>
<body>
<div class="email-container">
    {% block email_body %}
        {% block email_hello %}
            <p style="margin-bottom: 15px;"><strong>{{ _('Dear') }} {{ project["owner"]["user_name"] }},</strong></p>
        {% endblock email_hello %}

        {% block email_message %}
            <p style="margin-bottom: 15px;">
                {{ _('After reviewing your publication request for') }} <strong>{{ project["project_cod"] }} – {{ project["project_name"] }}</strong>, {{ _('the 1000FARMS admin team was unable to approve it.') }}.
            </p>
            {{ _('Request details') }}:
            <ul><strong>{{ _('Project Name') }}:</strong> {{ project["project_name"] }}</ul>
            <ul><strong>{{ _('Selected Repositories') }}:</strong> {{ repositories }}</ul>
            <ul><strong>{{ _('Selected License') }}:</strong> {{ license }}</ul>
            <ul><strong>{{ _('Status') }}:</strong> {{ _("Rejected") }}</ul>
            <ul><strong>{{ _('Reason for rejection') }}:</strong></ul>
            <ul>{{ admin_message }}</ul>
            <p style="margin-bottom: 15px;">{{ _('Thank you for contributing shareable data through ClimMob. Your published dataset is now available through the selected repositories.') }}</p>
        {% endblock email_message %}

        {% block email_goodbye %}
            <p>{{ _('Best regards,') }}<p>
            <p style="margin-bottom: 0;">{{ _('The ClimMob team') }}</p>
            <br>
            <img src="{{ logo }}" style="width:45%; max-width:100px; height:auto;" >
        {% endblock email_goodbye %}
    {% endblock email_body %}
</div>
</body>
</html>