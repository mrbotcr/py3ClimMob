<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f9f9f9;
            padding: 20px;
            color: #333;
            line-height: 1.6;
            margin: 0;
            text-align: center;
        !important;
        }

        .email-container {
            background-color: #ffffff;
            border: 1px solid #ddd;
            padding: 30px;
            border-radius: 6px;
            margin: 0 auto;
            width: 600px;
            display: inline-block;
        !important;
            text-align: left;
        }
    </style>
</head>
<body>
<div class="email-container">
    {% block email_body %}
        {% block email_hello %}
            <p style="margin-bottom: 15px;"><strong>{{ _('Dear 1000FARMS Administrator') }},</strong></p>
        {% endblock email_hello %}

        {% block email_message %}
            <p style="margin-bottom: 15px;">
                {{ _('Please be advised that Project ') }}
                <strong>{{ project_info["project_cod"] }}</strong> {{ _('was officially finalized today, ') }} {{ date }}.
            </p>
            <p style="margin-bottom: 15px;">
                {{ _('All project-related tasks and activities have been blocked. From this point forward, all project-related tasks, data entries, and activities are permanently locked. Thank you for your support in bringing this project to successful completion.') }}
            </p>
            <p>{{ _('The project details are as follows::') }}</p>
            <p>{{ _('Project Name') }}: <strong>{{ project_info["project_name"] }}</strong></p>
            <p>{{ _('Project Code') }}: <strong>{{ project_info["project_cod"] }}</strong></p>
            <p>{{ _('Project Principal investigation') }}: <strong>{{ project_info["project_pi"] }}</strong></p>
            <p>{{ _('Project owner') }}: <strong>{{ project_info["owner"]["user_name"] }}</strong></p>
            <p>{{ _('Country') }}: <strong>{{ project_info["project_cnty"] }}</strong></p>
            <p>{{ _('Crop name') }}: <strong>{{ project_info["project_curated_cropname"] }}</strong></p>
            <p>{{ _('Affiliation') }}: <strong>{{ project_info["project_affiliation"] }}</strong></p>
            <p>{{ _('Creation date') }}: <strong>{{ project_info["project_creationdate"] }}</strong></p>
            <p>{{ _('Project Status') }}: <strong>{% if project_info["project_status"] == 0 %}
                            {{ _("Undefined") }}
                        {% elif project_info["project_status"] == 1 %}
                            {{ _("Definition") }}
                        {% elif project_info["project_status"] == 2 %}
                            {{ _("In progress") }}
                        {% elif project_info["project_status"] == 3 %}
                            {{ _("Finalized") }}
                        {% endif %}</strong></p>
            <p style="margin-bottom: 15px;">{{ _('Thank you for your continued collaboration.') }}</p>
        {% endblock email_message %}

        {% block email_goodbye %}
            <p style="margin-bottom: 0;">{{ _('Best regards,') }}<br>{{ _('The ClimMob team') }}</p>
        {% endblock email_goodbye %}
    {% endblock email_body %}
</div>
</body>
</html>