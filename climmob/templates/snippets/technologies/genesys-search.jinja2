{% block css %}
    {% cssresource request,'coreresources','icheck' %}
    {% cssresource request,'coreresources','datatables' %}
    {% cssresource request,'coreresources','sweet' %}
    {% cssresource request,'coreresources','footable' %}
    {% cssresource request,'coreresources','select2' %}
{% endblock css %}

{% block topScripts %}
    {% jsresource request,'coreresources','footable' %}
    {% jsresource request,'coreresources','icheck' %}
    {% jsresource request,'coreresources','technologies' %}
    {% jsresource request,'coreresources','datatables' %}
    {% jsresource request,'coreresources','sweet' %}
    {% include 'snippets/delete.jinja2' %}
    {% jsresource request,'coreresources','select2' %}
{% endblock topScripts %}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox">
            <div class="ibox-title">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1em;">
                    <h5>{{ _("External technology options") }}</h5>
                </div>
            </div>
            <div class="ibox-content">
                <div class="form-group"
                     style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1em;">
                    <label class="col-sm-3 control-label" for="q">{{ _('Search') }}</label>
                    <div class="col-sm-9">
                        <select id="q" name="q" class="form-control inputForQuestionSelect"
                                style="width: 100%; !important;" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="ibox">
            <div class="ibox-title">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1em;">
                    <h5>{{ _("Details") }}</h5>
                </div>
            </div>
            <div class="ibox-content">
                <section id="synonym-section">

                    <h4>{{ _("Synonyms:") }}</h4>
                    <table id="synonyms" class="table table-stripped" style="width: 100%;">
                        <thead>
                        <tr>
                            <th>{{ _("Name") }}</th>
                        </tr>
                        </thead>
                    </table>
                </section>
                <hr>
                <section id="references-section">
                    <h4>{{ _("Cross-references:") }}</h4>
                    <table id="references" class="table table-stripped" style="width: 100%;">
                        <thead>
                        <tr>
                            <th>{{ _("Name") }}</th>
                            <th>{{ _("Link") }}</th>
                        </tr>
                        </thead>
                    </table>
                </section>
            </div>
        </div>
    </div>
</div>

<script>
    function formatOption(item) {
        if (item.default_display_name === undefined) {
            return {{ _("Select one option") }}
        }
        return item.default_display_name + " (" + item.germplasm_genus + ')';
    }

    $(document).ready(function () {
        const synonymsTable = $('#synonyms').DataTable({
            columns: [
                {data: "name"}
            ],
            dom: 't',
            paging: true,
            ordering: false,
            language: {
                emptyTable: {{ _("No items to display") }}
            },
        });

        const referencesTable = $('#references').DataTable({
            columns: [
                {data: "name"},
                {data: "base_url"}
            ],
            dom: 't',
            paging: true,
            ordering: false,
            language: {
                emptyTable: {{ _("No items to display") }}
            },
        });

        $('#q').on('change', function () {
            if ($(this).val() === "") {
                synonymsTable.clear().draw()
                referencesTable.clear().draw();
                return;
            }
            $.ajax({
                url: 'http://localhost:8000/api/germplasm' + '/' + $(this).val(),
                method: 'GET',
                headers: {
                    "Authorization": "Api-key rMm18pLw.LJSPV0cg5UUEaUtE6oQ6uTzotT0fD6Un"
                },
                success: function (response) {
                    synonymsTable.clear().rows.add(response.synonyms).draw();
                    referencesTable.clear().rows.add(response.source).draw();
                },
                error: function (err) {
                    console.error('Error:', err);
                }
            });
        });

        $("#q").select2({
            data: [],
            templateResult: formatOption,
            templateSelection: formatOption,
            placeholder: "Select an optionz",
            allowClear: true,
            ajax: {
                url: "http://localhost:8000/api/germplasm",
                dataType: 'json',
                delay: 250,
                headers: {
                    "Authorization": "Api-key rMm18pLw.LJSPV0cg5UUEaUtE6oQ6uTzotT0fD6Un"
                },
                data: function (params) {
                    return {
                        q: params.term,
                        page: params.page,
                        limit: 100,
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data,
                        pagination: {
                            more: data.length === 10
                        }
                    };
                },
                cache: true
            }
        });

    });
</script>
