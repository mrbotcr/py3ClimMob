{% macro licenses_container() %}
    {% from 'snippets/project/publishing/license_logos.jinja2' import license_logos with context %}
    {% from 'snippets/project/publishing/license_description.jinja2' import license_description with context %}

    <h4>{{ _("License") }}</h4>
    <p>{{ _("Select the license that defines how others may reuse your dataset.") }}</p>
    <div id="licenses" class="flex flex-col" style="gap: 1em;">
        {% for license in licenses %}
            <div class="row" style="margin-inline: 0;">
                <div class="ibox collapsed"
                     style="outline: 2px solid #e7eaec; outline-offset: -1px; padding: 0; margin-bottom: 0; border-radius: 5px">
                    <div class="ibox-title flex "
                         style="justify-content: space-between; padding-block: 0; align-items: center; border: none; ">
                        <div class="i-checks inline">
                            <label class="flex"
                                   style="gap: 1em;align-items: center; margin-bottom: 0;">
                                <input type="radio"
                                       id="license-{{ license.publication_license_id }}"
                                       name="license" value="{{ license.publication_license_id }}"
                                        {% if license.publication_license_id == project_license_id %}
                                       checked
                                        {% endif %}
                                        {% if project_license_id %}
                                       disabled
                                        {% endif %}
                                >
                                <label style="margin-bottom: 0;">
                                    {{ license.publication_license_name }}
                                    {% if license.publication_license_id == 1 %} {# CC0 #}
                                        ({{ _("Recommended") }})
                                    {% endif %}
                                    {{ license_logos(license.publication_license_id) }}
                                </label>
                            </label>
                        </div>
                        <div class="ibox-tools">
                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        {{ license_description(license.publication_license_id) }}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}