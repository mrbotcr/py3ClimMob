{% macro downloads(route, form_type, ass_id='') %}
    <style>
        #dashboard-downloads th,
        #dashboard-downloads td {
            width: 33.33%;
            text-align: center;
            vertical-align: middle;
        }
    </style>

    <h3>{{ _("Downloads") }}</h3>
    <table id="dashboard-downloads" class="table table-bordered">
        <thead>
        <tr>
            <th>{{ _('File Type') }}</th>
            <th>{{ _('Raw') }}</th>
            <th>{{ _('Anonymized') }}</th>
        </tr>
        </thead>

        <tbody>
        <tr>
            <td>
                CSV
            </td>
            <td>
                <a class="btn btn-success btn-rounded btn-block"
                   href="{{ request.route_url(
                        route,
                        user=activeProject["owner"].user_name,
                        project=activeProject.project_cod,
                        formid=form_type,
                        formatid='csv',
                        codeid=ass_id) }}">
                    <i class="fa fa-download"></i>
                </a>
            </td>
            <td>
                <a class="btn btn-success btn-rounded btn-block"
                   href="{{ request.route_url(
                        route,
                        user=activeProject["owner"].user_name,
                        project=activeProject.project_cod,
                        formid=form_type,
                        formatid='csv',
                        codeid=ass_id,
                        _query={"anonymize": True}) }}">
                    <i class="fa fa-download"></i>
                </a>
            </td>
        </tr>

        <tr>
            <td>
                XLSX
            </td>
            <td>
                <a class="btn btn-success btn-rounded btn-block"
                   href="{{ request.route_url(
                        route,
                        user=activeProject["owner"].user_name,
                        project=activeProject.project_cod,
                        formid=form_type,
                        codeid=ass_id,
                        formatid='xlsx') }}">
                    <i class="fa fa-download"></i>
                </a>
            </td>
            <td>
                <a class="btn btn-success btn-rounded btn-block"
                   href="{{ request.route_url(
                        route,
                        user=activeProject["owner"].user_name,
                        project=activeProject.project_cod,
                        formid=form_type,
                        codeid=ass_id,
                        formatid='xlsx',
                        _query={"anonymize": True}) }}">
                    <i class="fa fa-download"></i>
                </a>
            </td>
        </tr>
        </tbody>
    </table>
{% endmacro %}
