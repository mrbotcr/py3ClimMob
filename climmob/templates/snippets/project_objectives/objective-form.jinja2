<style>
    .location-option {
        padding: 0.3em;
    }

    .location-option.active {
        border: 1px solid black;
    }
</style>

<div class="form-group">
    <label class="col-sm-4 control-label">{{ _('Objective name') }}</label>
    <div class="col-sm-8"><input type="text" class="form-control inputsEnumerators"
                                 value="{{ dataworking['pobjective_name'] }}" id="pobjective_name"
                                 name="pobjective_name" placeholder=" " required=""
                                 oninvalid="this.setCustomValidity('{{ _("Write the pobjective name.") }}')"
                                 onchange="this.setCustomValidity('')"></div>
    <input type="hidden" name="objective_id" id="pobjective_id" class="inputsEnumerators">
    <label class="col-sm-4 control-label">{{ _('Categories') }}</label>
    <div class="col-sm-8 m-sm-1">
        <section class="col-sm-4">
            {% for luoa in luoas %}
                <div class="location-option btn-block p-3"
                     id="location-option-{{ luoa.plocation_id }}"
                     onclick="selectLocation(this, {{ luoa.plocation_id }})">
                    {{ luoa.plocation_name }}
                    <strong>
                    (<span class="loc-cnt" id="loc-cnt-{{ luoa.plocation_id }}">0</span>)
                    </strong>
                </div>
            {% endfor %}
        </section>

        <section class="col-sm-6">
            {% for luoa in luoas %}
                <div class="chk-field hidden" id="chk-field-{{ luoa.plocation_id }}">
                    {% for puoa_name in luoa.puoa_names %}
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   value="{{ luoa.pluoa_ids[loop.index0] }}"
                                   id="luoa-{{ luoa.pluoa_ids[loop.index0] }}"
                                   name="luaos"
                                   onchange="checkClick('luoa-{{ luoa.pluoa_ids[loop.index0] }}', {{ luoa.plocation_id }})">
                            <label class="" for="luoa-{{ luoa.pluoa_ids[loop.index0] }}">
                                {{ puoa_name }}
                            </label>
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}

        </section>
    </div>

</div>

<script>

    $(document).ready(function () {
        $(".form-check-input").prop("checked", false);
        $(".loc-cnt").text("0");
    })

    function selectLocation(clicked, ploc_id) {
        $(".location-option").removeClass('active');
        $(`#location-option-${ploc_id}`).addClass('active');
        $(".chk-field").addClass('hidden');
        $(`#chk-field-${ploc_id}`).removeClass('hidden');
        console.log(`Selected ${ploc_id}`);
    }

    function checkClick(input_id, ploc_id) {
        let counter = $(`#loc-cnt-${ploc_id}`)
        let count = Number(counter.text())
        let input = $(`#${input_id}`)
        if (input[0].checked) {
            count += 1
        } else {
            count -= 1
        }
        counter.text(Math.max(count, 0))
    }

</script>

