{% extends 'dashboard/dashboard.jinja2' %}

{% block title %}
    <title>{{ _("ClimMob | All Projects") }}</title>
{% endblock title %}

{% block css %}

    {% cssresource request,'coreresources','tour' %}
    {% cssresource request,'coreresources','icheck' %}
    {% cssresource request,'coreresources','dataTables2_3_2' %}
    {% cssresource request,'coreresources','dataTables2_3_2_columnControl' %}
    {% cssresource request,'coreresources','dataTables2_3_2_buttons' %}

    <style>
        th {
            text-align: left !important;

            max-width: 400px;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        td {
            max-width: 400px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .table.dataTable{
            margin: 0px;
        }

        div.dt-buttons > .dt-button {
            font-size: 14px;
            font-weight: normal;
            line-height: 1.42857143;
            text-align: center;
            white-space: nowrap;
            cursor: pointer;
            color: inherit;
            background: white;
            border: 1px solid #e7eaec;
            border-radius: 3px;

        }

        #all-projects tbody tr:hover {
           background-color: #FAFAFA;
           cursor: pointer;
       }

        .dtcc-button.dtcc-button_active > .dtcc-button-icon svg * {
            stroke: #1ab394;        }

        .dtcc-button.dtcc-button_active {
            background: rgba(152, 152, 152, 0.44) !important;
        }

    </style>
{% endblock css %}

{% block topScripts %}
    {% jsresource request,'coreresources','toastr' %}
    {% jsresource request,'coreresources','tour' %}
    {% jsresource request,'coreresources','icheck' %}
    {% jsresource request,'coreresources','datatable2_3_2js' %}
    {% jsresource request,'coreresources','datatable2_3_2js_columControl' %}
    {% jsresource request,'coreresources','datatable2_3_2js_buttons3_0_0' %}
    {% jsresource request,'coreresources','datatable2_3_2js_colVis' %}

{% endblock topScripts %}

{% block pageheading %}
    {% set _title= _("All Projects") %}
    {% set removeBasicBreadcrumb = True %}
    {% set extra =[[_("Projects"), ]] %}
    {% include 'snippets/menuheading.jinja2' %}
{% endblock %}

{% block pagecontent %}

    {% set createBoton = true %}
    {% if request.registry.settings.get("projects.limit", "false") == "true" and numberOfProjects >= request.registry.settings.get("projects.quantity", 0)|int%}
        {% set createBoton = false %}
    {% endif %}

    <div class="row">
        <div class="col-lg-12">

                <div class="ibox">
                    <div class="ibox-title">
                        <h5>{{ _("All projects assigned to this account") }}</h5>
                        <div class="ibox-tools">
                            {% if request.registry.settings.get("projects.limit", "false") == "true" %}
                                {{ _("{}/{} projects created".format(numberOfProjects, request.registry.settings.get("projects.quantity", "0"))) }}
                            {% endif %}
                            {% if createBoton == true %}
                                <a class="btn btn-primary" href="{{ request.route_url('newproject') }}">{{ _("Add new project") }}</a>
                            {% endif %}

                        </div>
                    </div>
                    <div class="ibox-content">
                        {% if userProjects %}
{#                            <div class="text-left">#}
{#                                <p>{{ _("Click on the row of the table to change the project in the \"Project overview\" section") }}.  <a class="btn btn-success btn-rounded  btn-xs" style="color: white" onclick="showHelp()"><i class="fa fa-question-circle"></i> {{  _("Show help") }}</a></p>#}
{##}
{#                                <br><br>#}
{#                            </div>#}

                            <table class="display nowrap table table-stripped display " data-filter=#filter id="all-projects">
                                <thead>
                                    <tr>
{#                                        <th title="{{ _("Click on the row of the table to change the project in the \"Project overview\" section") }}.">{{ _("Project overview") }} <i class="fa fa-info-circle"> </i></th>#}
                                        <th>{{ _("Project ID") }}</th>
                                        <th>{{ _("Project name") }}</th>
                                        <th>{{ _("Owner") }}</th>
                                        <th>{{ _("Your role") }}</th>
                                        <th>{{ _("Principal investigator") }}</th>
                                        <th>{{ _("Email") }}</th>
                                        <th>{{ _("Progress status") }}</th>
                                        <th>{{ _("Creation date") }}</th>
                                        <th>{{ _("Tags") }}</th>
                                        {% if createBoton == true %}
                                            <th> {#  {{ _("view") }} #}</th>
                                        {% endif %}
                                        {% if createBoton == true %}
                                            <th> {#  {{ _("Clone project") }} #}</th>
                                        {% endif %}
                                        {% if createBoton == true %}
                                            <th> {#  {{ _("Share") }} #}</th>
                                        {% endif %}

                                    </tr>

                                </thead>
                                <tbody>
                                    {% for project in userProjects %}
                                        <tr onclick="window.location = '{{ request.route_url('dashboard', _query={'user':project["owner"].user_name, "project": project.project_cod}) }}';">
{#                                            <td style="width: 165px" class="text-center">#}
{#                                                <div class="i-checks" style="text-align: center" >#}
{#                                                    <label>#}
{#                                                        <input name="check_project" type="radio" {% if project.project_dashboard == 1%}checked{% endif %} urlRedirect="{{ request.route_url('dashboard', _query={'user':project["owner"].user_name, "project": project.project_cod}) }}"> <i></i>#}
{#                                                    </label>#}
{#                                                </div>#}
{#                                                {% if project.project_dashboard == 1%}#}
{#                                                    <i class="fa fa-dot-circle-o " style="font-size: 30px; color: #1ab394"></i>#}
{#                                                {% endif %}#}
{#                                            </td>#}

                                            <td>
                                                <p>{{ project.project_cod }}</p>
                                            </td>
                                            <td >
                                                <p>{{ project.project_name }}</p>
                                            </td>
                                            <td>
                                                <p>{{ project.owner["user_name"] }}</p>
                                            </td>

                                            <td>
{#                                                <i class="fa fa-user-circle-o" style="font-size: 30px"></i><br>#}
                                                <p>
                                                    {% if project.access_type== 1 %}
                                                        {{ _("Owner") }}
                                                    {% else %}
                                                        {% if project.access_type== 2 %}
                                                            {{ _("Administrator") }}
                                                        {% else %}
                                                            {% if project.access_type== 3 %}
                                                                {{ _("Editor") }}
                                                            {% else %}
                                                                {{ _("Member") }}
                                                            {% endif %}
                                                        {% endif %}
                                                    {% endif %}
                                                </p>
                                            </td>
                                            <td >
                                                <p>{{ project.project_pi }}</p>
                                            </td>
                                            <td>
                                                <p>{{ project.project_piemail }}</p>
                                            </td>
                                            <td>

                                                <p>
                                                    {% if project.project_regstatus == 0 %}
                                                        {{ _("Registration not yet started") }}
                                                    {% else %}
                                                        {% if project.project_regstatus == 1 %}
                                                            {{ _("Registration ongoing") }}
                                                        {% else %}
                                                            {% if project.project_regstatus == 2 %}

                                                                {% if project.project_assstatus == 0 %}
                                                                    {{ _("Registration closed") }}
                                                                {% else %}
                                                                    {{ _("Trial data collection / Analysis ongoing") }}
                                                                {% endif %}

                                                            {% endif %}

                                                        {% endif %}

                                                    {% endif %}
                                                </p>

                                            </td>
                                            <td>
                                                <p>{{ project.project_creationdate.strftime('%d %b %Y') }}</p>
                                            </td>
                                            <td>
                                                {% for tag in project.project_tags.split(",") %}
                                                    <span class="label label-info">{{ tag }}</span>
                                                {% endfor %}
                                            </td>


                                            <td >
                                                {% if createBoton == true %}

                                                    <a class="btn btn-primary btn-xs" href="{{ request.route_url('dashboard', _query={'user':project["owner"].user_name, "project": project.project_cod}) }}">{{ _("View") }}</a>
                                                {% endif %}
                                            </td>


                                            <td >
                                                {% if createBoton == true %}
                                                    <a class="btn btn-primary btn-xs" href="{{ request.route_url('cloneProject', _query={"stage":2, "user": project.owner["user_name"],"project": project.project_cod}) }}">{{ _("Clone") }}</a>
                                                {% endif %}
                                            </td>
                                            <td >
                                                {% if createBoton == true %}
                                                    <a class="btn btn-primary btn-xs"
                                                       href="{{ request.route_url('shareProject',user=project.owner["user_name"],project=project.project_cod) }}"> {{ _("Share") }}</a>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}

                                </tbody>
                            </table>
                        {% else %}

                            <div style="text-align: center">
                                <h3><i class="fa fa-tim"></i> {{ _("You don't have projects.") }}</h3>
                                <a class="btn btn-primary" href="{{ request.route_url('newproject') }}">{{ _("Add new project") }}</a>
                            </div>

                        {% endif %}
                    </div>
                </div>
        </div>
    </div>

    <script>

        $(document).ready(function (){

            $('.i-checks').iCheck({
                checkboxClass: 'icheckbox_square-green',
                radioClass: 'iradio_square-green',
            });

            $('.i-checks input[type="radio"]').on('ifChecked', function (event) {
                const url = $(this).attr('urlRedirect');
                if (url) {
                    window.location.href = url;
                }
            });

            {% if userProjects %}
                const hiddenIndexes = [4,5,8];

                const ToggleableColumns = [3,4,5,6,7,8];

                const table = new DataTable('#all-projects', {

                    scrollX: true,
                    ordering: true,
                    deferRender: true,
                    columnControl: {
                        target: 0,
                        content: [
                            {
                                extend: 'dropdown',
                                icon: 'filter',
                                content: ['searchList']
                            }
                        ],
                    },
                    columnDefs: [
                        {target: -1, columnControl: [], orderable: false },
                        {target: -2, columnControl: [], orderable: false },
                        {target: -3, columnControl: [], orderable: false },
                        {
                            targets: hiddenIndexes,
                            visible: false,
                        },
                    ],
                    layout: {
                        topStart: {
                            buttons: [
                                {
                                    extend: 'colvis',
                                    text: '{{ _("Show / Hide columns") }}',
                                    className: 'btn btn-default',
                                    columns: ToggleableColumns
                                },
                                {
                                    extend: 'pageLength',
                                    text: '{{ _("Rows per Page") }}',
                                    className: 'dt_button_custom',
                                }
                            ]
                        },
                        topEnd: {
                            search: {
                                return: true,
                                text: '{{ _("General search:") }} ',
                                className: 'form-control',
                            },
                        },
                        bottomStart: {
                            info: {
                                return: true,
                                text: "{{ _('Showing _START_ to _END_ of _TOTAL_ entries') }}",
                            },
                        },
                    },
                })
            {% endif %}

        });

        function showHelp()
        {
            var tour = new Tour({
                steps: [
                        {
                            element: "#div_for_help",
                            title: "{{ _("Switch project") }}",
                            content: "<p>{{ _("Click on the row of the table to change the project in the \"Project overview\" section.") }}</p><img src='{{ request.url_for_static('gif/switch_project.gif') }}' />",
                            placement: "bottom"
                        }
                       ],
                template: "<div class='popover tour' style='border-color: #23c6c8; max-width: none; width:757px'><div class='arrow' ></div><h3 class='popover-title btn-info'></h3><div class='popover-content'></div><div class='popover-navigation'> <button class='btn btn-sm btn-danger' data-role='end'><i class='fa fa-close'></i> {{ _("Close") }}</button> </div>",
                backdrop: true,
                backdropContainer: 'body'
            });

            // Initialize the tour
            tour.init();
            tour.restart();
        }
    </script>



{% endblock pagecontent %}
