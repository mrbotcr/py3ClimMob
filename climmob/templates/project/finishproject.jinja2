{% extends 'dashboard/dashboard.jinja2' %}

{% block title %}
    <title>{{ _("ClimMob | Confirm Project Finalization") }}</title>
{% endblock title %}

{% block pageheading %}
    {% set _title= _("Confirm project finalization") %}
    {% include 'snippets/menuheading.jinja2' %}
{% endblock %}

{% block css %}
    {% cssresource request,'coreresources','sweet' %}
    <style>
    .wide-swal {
        width: 800px !important;
    }
    .sweet-alert button.confirm {
        background-color: #1ab394 !important;
    }
    .sweet-alert button.cancel {
        border : 1px solid #1ab394 !important;
        border-color: #1AB394 !important;
        background-color: transparent;
        color: #1ab394
    }
    </style>
{% endblock css %}


{% block topScripts %}
    {% jsresource request,'coreresources','sweet' %}
    {% jsresource request,'coreresources','toastr' %}
{% endblock topScripts %}

{% block pagecontent %}
    {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endif %}

    {% set can_edit = True %}
    {% if activeProject.project_status == 3 %}
        {% set can_edit = False %}
    {% endif %}

{% set progress_status %}
    {% if project_info.project_regstatus == 0 %}
        {{ _("Registration not yet started") }}
    {% elif project_info.project_regstatus == 1 %}
        {{ _("Registration ongoing") }}
    {% elif project_info.project_regstatus == 2 %}
        {% if project_info.project_assstatus == 0 %}
            {{ _("Registration closed") }}
        {% else %}
            {{ _("Trial data collection / Analysis ongoing") }}
        {% endif %}
    {% endif %}
{% endset %}

    {% if can_edit %}
        <div class="row col-lg-4">
            <div class="ibox">
                <div class="ibox-title">
                    <h5> {{ _('Confirmation details') }} </h5>
                    <span class="label label-warning">{{ _('Warning') }}</span>
                </div>
                <div class="ibox-content">
                    <div class="row d-flex justify-content-center align-items-center">
                        <div class="col-lg">
                            <table class="table table-bordered table-striped">
                                <thead>
                                <tr>
                                    <th>{{ _('Field name') }}</th>
                                    <th>{{ _('Value') }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr>
                                    <td>{{ _('Project name') }}</td>
                                    <td>{{ project_info["project_name"] }}</td>
                                </tr>
                                <tr>
                                    <td>{{ _('Creation date') }}</td>
                                    <td>{{ project_info["project_creationdate"] }}</td>
                                </tr>
                                <tr>
                                    <td>{{ _('Progress') }}</td>
                                    <td>
                                    {% if project_info.project_regstatus == 0 %}
                                        {{ _("Registration not yet started") }}
                                    {% else %}
                                        {% if project_info.project_regstatus == 1 %}
                                            {{ _("Registration ongoing") }}
                                        {% else %}
                                            {% if project_info.project_regstatus == 2 %}
                                                {% if project_info.project_assstatus == 0 %}
                                                    {{ _("Registration closed") }}
                                                {% else %}
                                                    {{ _("Trial data collection / Analysis ongoing") }}
                                                {% endif %}
                                            {% endif %}
                                        {% endif %}
                                    {% endif %}
                                    </td>
                                </tr>

                                <tr>
                                    <td>{{ _('Project Status') }}</td>
                                    <td>
                                        {% if project_info["project_status"] == 0 %}
                                            {{ _("Undefined") }}
                                        {% elif project_info["project_status"] == 1 %}
                                            {{ _("Definition") }}
                                        {% elif project_info["project_status"] == 2 %}
                                            {{ _("In progress") }}
                                        {% elif project_info["project_status"] == 3 %}
                                            {{ _("Finalized") }}
                                        {% endif %}
                                    </td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <p>
                        {{ _('If you are sure about it please, press the button.') }}
                    </p>
                    <a class="btn btn-primary btn-rounded btn-block"
                       data-title="{{ _('Do you want to finalize the project') }}?<br><i>{{ project_info['project_name'] }}</i>"
                       onclick="swal({ html: true,
                       title: this.getAttribute('data-title'),
                       showCancelButton: true,
                       cancelButtonText: 'Cancel',
                       customClass: 'wide-swal'
                       }, function(isConfirm) {if (isConfirm) {document.getElementById('finishForm').submit();}});return false;">
                        <i class="fa fa-check-square-o"></i>
                        {{ _('Confirm project finalization') }}
                    </a>
                    <form id="finishForm" method="POST" action="{{ request.url }}">
                        <input type="hidden" name="csrf_token" value="{{ request.session.get_csrf_token() }}">
                    </form>
                </div>
            </div>
        </div>
    {% endif %}

    {% if not can_edit %}
        <div class="row">
            <div class="ibox">
                <div class="ibox-title">
                    <h5>{{ _('Thanks for confirm the finish of your project') }}</h5>
                    <span class="label label-success">{{ _('Success') }}</span>
                </div>
                <div class="ibox-content">
                    <p>
                        {{ _('Thanks for confirm the finish of your project. We really appreciate your effort.') }}
                    </p>
                </div>
            </div>
        </div>
    {% endif %}
{{ total_ass_records }}
{{ project_info.project_registration_and_analysis }}
{{ progress.regtotal }}
<script>
    {% if (total_ass_records > 5 or (project_info.project_registration_and_analysis == 1 and progress.regtotal >=5))
                        and progress.metadata == False %}
        var data_title="{{ _("Missing trial documentation") }}"
        var data_text="{{ _("Trial documentation' step is pending. Finalizing now will permanently disable the Analysis module for this project.") }}"
            window.onload = function sweet (){
                swal({ html: true,
                    title: data_title,
                    text:data_text,
                    type: 'warning',
                    showCancelButton: true,
                    cancelButtonText: 'Continue without Analysis',
                    confirmButtonText: 'Complete Trial Documentation',
                    customClass: 'wide-swal'
                }, function(isConfirm) {if (isConfirm) {
                    const url = "{{ request.route_url(
                        'Metadata', user=project_info['user_name'], project=project_info['project_cod']) }}";
                        location.href = url;
                }});return false;
            }
        {% endif %}
</script>

{% endblock pagecontent %}

{% block script %}
{% endblock script %}